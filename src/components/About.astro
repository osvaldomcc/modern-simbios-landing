---
/**
 * About Component
 * Focus: Strengthening local authority (country) and technical reliability.
 * Performance: Optimized image pipeline for team social proof.
 */
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// High-quality architectural visual representing stability and local presence.
// Source must be >= the rendered width (600) or the upscaler blurs it.
const aboutImage =
  "https://images.unsplash.com/photo-1554469384-e58fac16e23a?q=85&w=1200&auto=format&fit=crop";
---

<section
  id="about"
  class="py-24 bg-white dark:bg-brand-black transition-colors duration-vercel scroll-mt-20"
>
  <div class="container mx-auto px-6">
    <div
      class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-16 lg:gap-24"
    >
      <!-- Left Column: Branding Visualization -->
      <div class="w-full md:w-1/2 relative group">
        <!-- Brand Glow (Operational Silence) -->
        <div
          class="absolute -inset-4 bg-primary/10 dark:bg-action/5 rounded-card blur-3xl group-hover:bg-primary/20 transition-all duration-700"
          aria-hidden="true"
        >
        </div>

        <div
          class="relative bg-white dark:bg-surface border border-gray-100 dark:border-white/10 p-2 rounded-card shadow-2xl overflow-hidden"
        >
          <Image
            src={aboutImage}
            alt="company technical leadership and local expertise"
            width={600}
            height={600}
            class="w-full aspect-square object-cover rounded-inner transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />

          <!-- Local Authority Badge -->
          <div
            class="absolute bottom-6 left-6 bg-brand-navy/95 dark:bg-brand-yellow px-5 py-2.5 rounded-inner shadow-xl backdrop-blur-sm"
          >
            <span
              class="text-white dark:text-brand-black text-[10px] font-bold uppercase tracking-[0.2em]"
            >
              {t("about.badge")}</span
            >
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative & Social Proof -->
      <div class="w-full md:w-1/2">
        <h2
          class="text-heading dark:text-brand-off-white text-4xl lg:text-5xl font-bold mb-8 tracking-tightest leading-[1.1]"
        >
          {t("about.title.part1")}
          <span class="text-primary dark:text-brand-sky"
            >{t("about.title.highlight")}</span
          >
        </h2>

        <div class="space-y-6">
          <p class="text-text-body dark:text-gray-400 text-lg leading-relaxed">
            {t("about.description.1")}
          </p>
          <p
            class="text-text-body dark:text-gray-300 text-lg leading-relaxed font-semibold"
          >
            {t("about.description.2")}
          </p>
        </div>

        <!-- Credibility Stats -->
        <dl class="mt-12 grid grid-cols-3 gap-6">
          {
            ["years", "offices", "degrees"].map((stat) => (
              <div class="border-l-2 border-brand-orange/40 dark:border-brand-yellow/40 pl-4">
                <dt class="sr-only">
                  {t(`about.stat.${stat}.label` as any)}
                </dt>
                <dd class="text-3xl lg:text-4xl font-bold text-heading dark:text-white tracking-tightest mb-1">
                  {t(`about.stat.${stat}.value` as any)}
                </dd>
                <dd class="text-xs text-text-body dark:text-gray-400 leading-snug">
                  {t(`about.stat.${stat}.label` as any)}
                </dd>
              </div>
            ))
          }
        </dl>

        <!-- Team Social Proof Grid -->
        <div class="mt-12 flex items-center gap-6">
          <div class="flex -space-x-4">
            {
              ["Felix", "Anita", "Marc"].map((name) => (
                <div class="relative group/avatar">
                  <Image
                    src={`https://i.pravatar.cc/300?u=${name}`}
                    alt={`company Senior Consultant ${name}`}
                    width={48}
                    height={48}
                    class="min-w-12 w-12 h-12 rounded-pill border-2 border-white dark:border-brand-black bg-gray-100 object-cover shadow-md group-hover/avatar:scale-110 group-hover/avatar:z-10 transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
          <div class="flex flex-col">
            <p
              class="text-xs font-bold text-primary dark:text-brand-yellow uppercase tracking-[0.3em] mb-1"
            >
              {t("about.social_proof")}
            </p>
            <div
              class="h-0.5 w-12 bg-brand-orange dark:bg-brand-yellow rounded-pill opacity-40"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

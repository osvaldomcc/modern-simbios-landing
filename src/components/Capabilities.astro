---
/**
 * Capabilities Component (Services)
 * Content: technology stacks and hireable profiles of the engineering practice.
 * Standards: systematic radius (16px cards / 12px inner), pill CTAs, hover lift.
 */
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const groups = [
  { id: "backend", items: [1, 2, 3, 4] },
  { id: "frontend", items: [1, 2, 3] },
  { id: "mobile", items: [1, 2, 3] },
  { id: "cloud", items: [1, 2, 3] },
  { id: "data", items: [1, 2, 3] },
];

const groupIcons: Record<string, string> = {
  backend: "M8 9l3 3-3 3m5 0h3M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z",
  frontend: "M3 5h18M3 12h18M3 19h12",
  mobile: "M12 18h.01M8 2h8a2 2 0 012 2v16a2 2 0 01-2 2H8a2 2 0 01-2-2V4a2 2 0 012-2z",
  cloud: "M3 15a4 4 0 004 4h10a4 4 0 100-8 5.5 5.5 0 00-10.5-1.5A3.5 3.5 0 003 15z",
  data: "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zm0 0v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3",
};

const profiles = [1, 2, 3, 4, 5];
---

<section
  id="services"
  class="py-24 bg-surface dark:bg-brand-black transition-colors scroll-mt-20"
  aria-labelledby="services-title"
>
  <div class="container mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-start gap-16 lg:gap-24">
      <!-- Strategic Narrative -->
      <div class="lg:w-2/5">
        <span
          class="inline-block px-4 py-1.5 rounded-pill bg-action/10 text-action text-[10px] font-bold uppercase tracking-[0.3em] mb-8"
        >
          {t("capabilities.badge")}
        </span>

        <h2
          id="services-title"
          class="text-4xl lg:text-5xl font-bold text-heading dark:text-white mb-6 tracking-tightest leading-[1.1]"
        >
          {t("capabilities.title.part1")}
          <span class="text-primary dark:text-brand-sky"
            >{t("capabilities.title.highlight")}</span
          >
        </h2>

        <p class="text-text-body dark:text-gray-400 text-lg leading-relaxed mb-10">
          {t("capabilities.subtitle")}
        </p>

        <!-- Available Profiles -->
        <div
          class="bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 rounded-card p-8"
        >
          <h3
            class="text-[10px] font-bold uppercase tracking-[0.2em] text-text-body/60 mb-6"
          >
            {t("capabilities.profiles.title")}
          </h3>
          <ul class="space-y-4">
            {
              profiles.map((id) => (
                <li class="flex items-start gap-3 text-heading dark:text-white font-medium">
                  <span
                    class="mt-0.5 shrink-0 w-5 h-5 rounded-pill bg-primary/10 dark:bg-brand-sky/10 text-primary dark:text-brand-sky flex items-center justify-center"
                    aria-hidden="true"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-3 h-3"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="3"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </span>
                  {t(`capabilities.profiles.${id}` as any)}
                </li>
              ))
            }
          </ul>
        </div>

        <a
          href="#contact"
          class="mt-8 inline-flex items-center gap-3 bg-action text-white dark:text-brand-black px-8 py-4 rounded-pill font-bold hover:scale-105 active:scale-95 transition-all duration-vercel shadow-lg shadow-action/20"
        >
          {t("capabilities.cta")}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Stack Grid -->
      <div class="lg:w-3/5 grid sm:grid-cols-2 gap-8 min-w-0">
        {
          groups.map((group) => (
            <article class="group bg-white dark:bg-white/5 border border-gray-100 dark:border-white/5 rounded-card p-8 hover:-translate-y-1 hover:shadow-2xl transition-all duration-vercel">
              <div class="flex items-center gap-4 mb-6">
                <span class="w-11 h-11 shrink-0 rounded-inner bg-brand-navy/5 dark:bg-brand-yellow/10 text-brand-navy dark:text-brand-yellow flex items-center justify-center group-hover:scale-110 transition-transform duration-vercel">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={groupIcons[group.id]}
                    />
                  </svg>
                </span>
                <h3 class="text-xl font-bold text-heading dark:text-white tracking-tightest wrap-anywhere hyphens-auto min-w-0">
                  {t(`capabilities.group.${group.id}` as any)}
                </h3>
              </div>

              <ul class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="px-3.5 py-1.5 rounded-pill bg-surface dark:bg-white/5 border border-gray-100 dark:border-white/10 text-sm font-medium text-text-body dark:text-gray-300">
                    {t(`capabilities.stack.${group.id}.${item}` as any)}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

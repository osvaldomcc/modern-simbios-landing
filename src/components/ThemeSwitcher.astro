---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex items-center">
  <div class="group relative">
    <button
      id="theme-toggle"
      type="button"
      aria-label={t("switcher.popover")}
      class="group relative flex h-12 w-12 cursor-pointer items-center justify-center overflow-hidden rounded-pill border border-gray-200 dark:border-white/10 bg-transparent transition-all duration-vercel hover:border-action active:scale-95 outline-none focus-visible:ring-2 focus-visible:ring-action"
    >
      <div
        class="relative h-6 w-6 overflow-hidden pointer-events-none"
        aria-hidden="true"
      >
        <!-- MOON ICON: Arrives from the RIGHT -->
        <span
          class="absolute inset-0 flex items-center justify-center text-action transition-all duration-700 origin-[100px_50%] rotate-90 opacity-0 dark:rotate-0 dark:opacity-100"
        >
          <svg class="h-full w-full" viewBox="0 0 32 32" fill="currentColor">
            <path
              d="M14.228 7.9439C10.5176 8.82869 7.75757 12.1054 7.75757 15.9987C7.75757 20.5716 11.5618 24.2919 16.2367 24.2919C19.2323 24.2919 21.9337 22.7699 23.4514 20.3585C23.2779 20.3676 23.1033 20.3722 22.9287 20.3722C17.7826 20.3722 13.5951 16.2772 13.5951 11.2435C13.5951 10.1032 13.8108 8.98914 14.228 7.9439Z"
            ></path>
          </svg>
        </span>

        <!-- SUN ICON: Arrives from the LEFT -->
        <span
          class="absolute inset-0 flex items-center justify-center text-action transition-all duration-700 origin-[-100px_50%] rotate-0 opacity-100 dark:-rotate-90 dark:opacity-0"
        >
          <svg class="h-full w-full" viewBox="0 0 32 32" fill="currentColor">
            <circle cx="16" cy="16" r="5"></circle>
            <path
              d="M16 3v3m0 20v3M3 16h3m20 0h3m-18.364-7.636l2.122 2.122m9.192 9.192l2.122 2.122m-13.436 0l2.122-2.122m9.192-9.192l2.122-2.122"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </span>
      </div>
    </button>

    <!-- POPOVER / TOOLTIP (Vercel Guidelines) -->
    <div
      role="tooltip"
      class="absolute top-full mt-3 left-1/2 -translate-x-1/2 px-2.5 py-1.5 bg-black dark:bg-white text-white dark:text-black text-[11px] font-medium rounded-md opacity-0 scale-95 pointer-events-none transition-all duration-200 group-hover:opacity-100 group-hover:scale-100 whitespace-nowrap border border-white/20 dark:border-black/10 shadow-xl z-50"
    >
      {t("switcher.popover")}
      <span class="ml-1 opacity-60" id="shortcut-hint"></span>
      <!-- Arrow pointing UP -->
      <div
        class="absolute bottom-full left-1/2 -translate-x-1/2 border-4 border-transparent border-b-black dark:border-b-white"
      >
      </div>
    </div>
  </div>
  <span id="theme-status" class="sr-only" aria-live="polite">Theme: light</span>
</div>

<script is:inline>
  const getPlatform = () => {
    const platform = (
      navigator.userAgentData?.platform || navigator.platform
    ).toLowerCase();
    return /mac|iphone|ipad|ipod/.test(platform) ? "mac" : "win";
  };

  const toggleTheme = () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    const status = document.getElementById("theme-status");
    if (status) status.textContent = `Theme: ${isDark ? "dark" : "light"}`;
  };

  const handleKeydown = (e) => {
    // Atajo Alt + T para evitar conflictos con funciones del sistema
    if (e.altKey && e.key.toLowerCase() === "t") {
      e.preventDefault();
      toggleTheme();
    }
  };

  const themeInit = () => {
    const themeButton = document.getElementById("theme-toggle");
    const hint = document.getElementById("shortcut-hint");
    if (!themeButton) return;

    // Actualizar indicador de atajo (⌥T o Alt+T)
    if (hint) {
      hint.textContent = getPlatform() === "mac" ? "⌥T" : "Alt+T";
    }

    // Persistencia del tema
    const savedTheme = localStorage.getItem("theme");
    if (
      savedTheme === "dark" ||
      (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.classList.add("dark");
    }

    themeButton.removeEventListener("click", toggleTheme);
    themeButton.addEventListener("click", toggleTheme);
  };

  // Ciclo de vida para Astro
  themeInit();
  document.addEventListener("astro:after-swap", themeInit);

  // Registrar evento global de teclado
  window.removeEventListener("keydown", handleKeydown);
  window.addEventListener("keydown", handleKeydown);
</script>

---
/**
 * Social Proof Component
 * Content: verified client roster from the reference site.
 * Performance: local WebP pipeline via astro:assets (no external host), lazy decoding.
 */
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/clients/*.webp",
  { eager: true },
);

const clients: { id: string; name: string }[] = [
  { id: "1", name: "NTT Data" },
  { id: "2", name: "Janssen Pharmaceutical" },
  { id: "3", name: "Johnson & Johnson" },
  { id: "4", name: "Cigna" },
  { id: "5", name: "Politie Police" },
  { id: "6-a", name: "Toyota" },
  { id: "6-b", name: "Test Aankoop" },
  { id: "7", name: "Electrabel" },
  { id: "8", name: "Algemeen Ziekenhuis Sint-Maarten" },
  { id: "9", name: "Emmaüs" },
  { id: "10-a", name: "HP" },
  { id: "10-b", name: "EDS" },
  { id: "11", name: "UCB" },
  { id: "12", name: "BNP Paribas" },
  { id: "13", name: "Nike" },
  { id: "14", name: "Amadeus" },
  { id: "15", name: "NMBS" },
  { id: "16", name: "IMAS" },
  { id: "17", name: "Deutsche Bank" },
  { id: "18", name: "Fluvius" },
  { id: "19", name: "Van Genechten Packaging" },
  { id: "20", name: "Katoen Natie" },
  { id: "21", name: "Clear2Pay" },
  { id: "22", name: "Centric" },
  { id: "23", name: "CRH" },
  { id: "24", name: "ING" },
  { id: "25", name: "SD Worx" },
  { id: "26", name: "bpost" },
  { id: "27", name: "FAVV" },
  { id: "28", name: "Ypto" },
  { id: "30", name: "USG Innotiv" },
  { id: "32", name: "Viveo" },
  { id: "34", name: "FPC" },
  { id: "35", name: "Gosselin Group" },
  { id: "36", name: "Nobel Biocare" },
  { id: "37", name: "Honda" },
  { id: "38", name: "MYCSN" },
  { id: "39", name: "OneSpan" },
  { id: "40", name: "Chapps" },
  { id: "41", name: "Politie Antwerpen" },
  { id: "42", name: "FOD Volksgezondheid" },
  { id: "43", name: "Federale Pensioendienst" },
];

const partners = clients.flatMap(({ id, name }) => {
  const meta = logoModules[`../assets/clients/${id}.webp`]?.default;
  return meta ? [{ name, meta }] : [];
});

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Double items for a seamless CSS loop
const marqueeItems = [...partners, ...partners];
---

<section
  class="py-16 bg-white dark:bg-brand-black border-y border-gray-100 dark:border-white/5 overflow-hidden group/marquee min-h-40 md:min-h-47.5 flex flex-col justify-center"
>
  <!-- Heading with Anthropic-style precision spacing -->
  <p
    class="text-center text-[10px] font-bold uppercase tracking-[0.5em] text-body mb-12 opacity-50"
  >
    {t("social.heading")}
  </p>

  <div class="relative flex overflow-x-hidden">
    <!-- Marquee Track: GPU Accelerated -->
    <div
      class="flex animate-marquee-slow whitespace-nowrap gap-16 md:gap-32 items-center hover:[animation-play-state:paused]"
    >
      {
        marqueeItems.map((partner) => (
          <div class="shrink-0 group/logo px-4">
            <Image
              src={partner.meta}
              alt={`${partner.name} logo`}
              width={160}
              class="h-7 md:h-9 w-auto transition-all duration-500 grayscale opacity-40 group-hover/logo:grayscale-0 group-hover/logo:opacity-100 dark:invert dark:group-hover/logo:invert-0"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>

    <!-- Edge Fades for Operational Silence -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-linear-to-r from-white dark:from-brand-black to-transparent"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-linear-to-l from-white dark:from-brand-black to-transparent"
    >
    </div>
  </div>
</section>

<style>
  @keyframes marquee-infinite {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee-slow {
    display: flex;
    width: max-content;
    animation: marquee-infinite 60s linear infinite;
    /* Hardware acceleration for 0 main-thread impact */
    will-change: transform;
    transform: translateZ(0);
  }

  .group\/marquee:hover .animate-marquee-slow {
    animation-play-state: paused;
  }
</style>

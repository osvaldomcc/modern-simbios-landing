import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Double items for a seamless CSS loop
const marqueeItems = [...partners, ...partners];
---

<section
  class="py-16 bg-white dark:bg-brand-black border-y border-gray-100 dark:border-white/5 overflow-hidden group/marquee min-h-40 md:min-h-47.5 flex flex-col justify-center"
>
  <!-- Heading with Anthropic-style precision spacing -->
  <p
    class="text-center text-[10px] font-bold uppercase tracking-[0.5em] text-body mb-12 opacity-50"
  >
    {t("social.heading")}
  </p>

  <div class="relative flex overflow-x-hidden">
    <!-- Marquee Track: GPU Accelerated -->
    <div
      class="flex animate-marquee-slow whitespace-nowrap gap-16 md:gap-32 items-center hover:[animation-play-state:paused]"
    >
      {
        marqueeItems.map((partner) => (
          <div class="shrink-0 group/logo px-4">
            <img
              src={partner.url}
              alt={`${partner.name} logo`}
              width="120"
              height="36"
              class="h-7 md:h-9 w-auto transition-all duration-500 grayscale opacity-40 group-hover/logo:grayscale-0 group-hover/logo:opacity-100 dark:invert dark:group-hover/logo:invert-0"
              loading="eager"
              decoding="async"
            />
          </div>
        ))
      }
    </div>

    <!-- Edge Fades for Operational Silence -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-linear-to-r from-white dark:from-brand-black to-transparent"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-linear-to-l from-white dark:from-brand-black to-transparent"
    >
    </div>
  </div>
</section>

<style>
  @keyframes marquee-infinite {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee-slow {
    display: flex;
    width: max-content;
    animation: marquee-infinite 60s linear infinite;
    /* Hardware acceleration for 0 main-thread impact */
    will-change: transform;
    transform: translateZ(0);
  }

  .group\/marquee:hover .animate-marquee-slow {
    animation-play-state: paused;
  }
</style>

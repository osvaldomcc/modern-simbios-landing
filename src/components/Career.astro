---
/**
 * Career Component
 * Content: open roles of the engineering practice + what we look for / offer.
 * Performance: CSS-driven filtering for 0ms main-thread delay.
 */
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const filters = ["all", "backend", "frontend", "mobile", "data"];

const jobs = [
  {
    id: "backend",
    category: "backend",
    type: "hybrid",
    isFeatured: true,
  },
  {
    id: "dotnet",
    category: "backend",
    type: "onsite",
    isFeatured: false,
  },
  {
    id: "python",
    category: "data",
    type: "remote",
    isFeatured: false,
  },
  {
    id: "frontend",
    category: "frontend",
    type: "hybrid",
    isFeatured: false,
  },
  {
    id: "mobile",
    category: "mobile",
    type: "remote",
    isFeatured: false,
  },
  {
    id: "data",
    category: "data",
    type: "onsite",
    isFeatured: false,
  },
];

const details = [
  { id: "quals", count: 7 },
  { id: "mission", count: 4 },
  { id: "offer", count: 5 },
];
---

<section
  id="vacancies"
  class="py-24 bg-surface dark:bg-brand-black transition-colors overflow-hidden scroll-mt-20"
>
  <div class="container mx-auto px-6">
    <!-- Systematic Header -->
    <div class="mb-16">
      <span
        class="inline-block px-4 py-1.5 rounded-pill bg-action/10 text-action text-[10px] font-bold uppercase tracking-[0.3em] mb-8"
      >
        {t("career.badge")}
      </span>
      <h2
        class="text-5xl md:text-7xl font-bold text-heading dark:text-white tracking-tightest mb-10 leading-[1.05]"
      >
        {t("career.title.part1")}
        <span class="text-primary dark:text-brand-sky"
          >{t("career.title.highlight")}</span
        >
      </h2>
      <p class="text-text-body text-xl max-w-2xl leading-relaxed">
        {t("career.description")}
      </p>
    </div>

    <!-- Interactive Filter System (Astro & CSS Optimized) -->
    <nav class="flex flex-wrap gap-4 mb-16" aria-label="Job categories">
      {
        filters.map((filter) => (
          <button
            class="filter-btn group px-7 py-2.5 rounded-pill font-bold text-sm transition-all duration-vercel border border-gray-200 dark:border-white/10 hover:border-action dark:hover:border-brand-yellow data-[active=true]:bg-primary data-[active=true]:text-white dark:data-[active=true]:bg-brand-yellow dark:data-[active=true]:text-brand-black cursor-pointer"
            data-filter={filter}
            data-active={filter === "all" ? "true" : "false"}
          >
            {t(`career.filter.${filter}` as any)}
          </button>
        ))
      }
    </nav>

    <!-- Dynamic Jobs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="jobs-grid">
      {
        jobs.map((job) => (
          <article
            class={`job-card group bg-white dark:bg-white/5 border border-gray-100 dark:border-white/5 p-8 md:p-10 rounded-card hover:shadow-2xl transition-all duration-vercel opacity-100 scale-100 ${job.isFeatured ? "md:col-span-2" : ""}`}
            data-category={job.category}
          >
            <div class="flex justify-between items-start mb-8">
              <div class="flex gap-3">
                <span class="px-3 py-1 rounded-inner bg-primary/5 text-primary dark:bg-brand-sky/10 dark:text-brand-sky text-[9px] font-bold uppercase tracking-widest">
                  {t(`career.filter.${job.category}` as any)}
                </span>
                <span class="px-3 py-1 rounded-inner bg-gray-50 dark:bg-white/5 text-text-body text-[9px] font-bold uppercase tracking-widest">
                  {t(`career.type.${job.type}` as any)}
                </span>
              </div>
              <div
                class="text-brand-orange dark:text-brand-yellow transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform font-bold"
                aria-hidden="true"
              >
                ↗
              </div>
            </div>

            <h3
              class={`${job.isFeatured ? "text-4xl md:text-5xl" : "text-2xl"} font-bold text-heading dark:text-white mb-6 tracking-tightest leading-tight`}
            >
              {t(`career.roles.${job.id}.title` as any)}
            </h3>

            <p class="text-text-body text-lg mb-10 line-clamp-3 leading-relaxed">
              {t(`career.roles.${job.id}.desc` as any)}
            </p>

            <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-white/5">
              <a
                href="#contact"
                class={`px-8 py-3.5 rounded-pill font-bold transition-all duration-vercel ${job.isFeatured ? "bg-action text-white dark:text-brand-black shadow-lg shadow-action/20 hover:scale-105 active:scale-95" : "border border-gray-200 dark:border-white/10 text-heading dark:text-white hover:bg-gray-50 dark:hover:bg-white/10"}`}
              >
                {t("career.apply")}
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Role Details: qualifications / mission / offer -->
    <div class="grid md:grid-cols-3 gap-8 mt-16">
      {
        details.map((block) => (
          <article class="bg-white dark:bg-white/5 border border-gray-100 dark:border-white/5 rounded-card p-8 md:p-10">
            <h3 class="text-xl font-bold text-heading dark:text-white mb-6 tracking-tightest">
              {t(`career.${block.id}.title` as any)}
            </h3>
            <ul class="space-y-3">
              {Array.from({ length: block.count }, (_, i) => (
                <li class="flex gap-3 text-text-body dark:text-gray-400 text-sm leading-relaxed">
                  <span
                    class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-pill bg-brand-orange dark:bg-brand-yellow"
                    aria-hidden="true"
                  />
                  {t(`career.${block.id}.${i + 1}` as any)}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="text-center mt-16">
      <a
        href="#contact"
        class="inline-flex items-center gap-3 bg-action text-white dark:text-brand-black px-8 py-4 rounded-pill font-bold hover:scale-105 active:scale-95 transition-all duration-vercel shadow-lg shadow-action/20"
      >
        {t("career.apply")}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  /**
   * High-Performance Filter Logic
   * Uses CSS attributes to minimize DOM manipulation (Anthropic Standard)
   */
  const buttons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".job-card");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter");

      // 1. Sync Button State
      buttons.forEach((b) => b.setAttribute("data-active", "false"));
      btn.setAttribute("data-active", "true");

      // 2. Optimized Filter Application
      cards.forEach((card) => {
        const category = card.getAttribute("data-category");
        const shouldShow = filter === "all" || filter === category;

        if (shouldShow) {
          card.style.display = "flex";
          card.style.flexDirection = "column";
          // Operational Silence: Fade in effect
          requestAnimationFrame(() => {
            card.style.opacity = "1";
            card.style.transform = "scale(1)";
          });
        } else {
          card.style.opacity = "0";
          card.style.transform = "scale(0.98)";
          // Delay display:none to allow fade out
          setTimeout(() => {
            if (btn.getAttribute("data-active") === "true") {
              card.style.display = "none";
            }
          }, 300);
        }
      });
    });
  });
</script>

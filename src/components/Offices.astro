---
/**
 * Offices Component
 * Content: the three Belgian offices (Brussels HQ, Wallonia, Flanders).
 * UX: equal-weight cards with region badge, direct tel/mail actions and hover lift.
 */
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const offices = [
  {
    id: "hq",
    address: "Avenue du Port 82, 1000 Bruxelles",
    phone: "+32 2 555 18 40",
    phoneHref: "+3225551840",
    email: "sales@company.com",
    primary: true,
  },
  {
    id: "walloon",
    address: "Chaussée de Namur 27, 5580 Rochefort",
    phone: "+32 84 555 02 10",
    phoneHref: "+32845550210",
    email: "sales@company.com",
    primary: false,
  },
  {
    id: "flanders",
    address: "Koningin Astridlaan 45, 9255 Buggenhout",
    phone: "+32 52 555 71 30",
    phoneHref: "+32525557130",
    email: "sales@company.com",
    primary: false,
  },
];
---

<section
  id="offices"
  class="py-24 bg-white dark:bg-brand-black transition-colors scroll-mt-20"
  aria-labelledby="offices-title"
>
  <div class="container mx-auto px-6">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="inline-block px-4 py-1.5 rounded-pill bg-action/10 text-action text-[10px] font-bold uppercase tracking-[0.3em] mb-8"
      >
        {t("offices.badge")}
      </span>
      <h2
        id="offices-title"
        class="text-4xl lg:text-5xl font-bold text-heading dark:text-white mb-6 tracking-tightest leading-[1.1]"
      >
        {t("offices.title.part1")}
        <span class="text-primary dark:text-brand-sky"
          >{t("offices.title.highlight")}</span
        >
      </h2>
      <p class="text-text-body dark:text-gray-400 text-lg leading-relaxed">
        {t("offices.subtitle")}
      </p>
    </header>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {
        offices.map((office) => (
          <article
            class={`group relative bg-surface dark:bg-white/5 border ${
              office.primary
                ? "border-primary/20 dark:border-brand-sky/20"
                : "border-gray-100 dark:border-white/5"
            } rounded-card p-6 md:p-8 lg:p-10 flex flex-col hover:-translate-y-1 hover:shadow-2xl transition-all duration-vercel`}
          >
            <div class="flex items-start justify-between gap-4 mb-8">
              <div class="min-w-0">
                <span class="inline-block max-w-full px-3 py-1 rounded-pill bg-brand-navy/5 dark:bg-brand-yellow/10 text-[9px] font-bold uppercase tracking-[0.2em] text-brand-navy dark:text-brand-yellow mb-4">
                  {t(`offices.${office.id}.label` as any)}
                </span>
                <h3 class="text-2xl font-bold text-heading dark:text-white tracking-tightest wrap-anywhere hyphens-auto">
                  {t(`offices.${office.id}.city` as any)}
                </h3>
              </div>
              <span
                class="shrink-0 w-11 h-11 rounded-inner bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 text-primary dark:text-brand-sky flex items-center justify-center group-hover:scale-110 transition-transform duration-vercel"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
              </span>
            </div>

            <p class="text-text-body dark:text-gray-400 mb-8 leading-relaxed">
              {office.address}
            </p>

            <div class="mt-auto pt-6 border-t border-gray-100 dark:border-white/5 space-y-3">
              <a
                href={`tel:${office.phoneHref}`}
                class="flex items-center gap-3 text-heading dark:text-white font-medium hover:text-action transition-colors duration-vercel"
              >
                <span
                  class="w-5 h-5 text-text-body/50"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.5a1 1 0 01-.5 1.2l-2.26 1.13a11 11 0 005.52 5.52l1.13-2.26a1 1 0 011.2-.5l4.5 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z"
                    />
                  </svg>
                </span>
                {office.phone}
              </a>
              <a
                href={`mailto:${office.email}`}
                class="flex items-center gap-3 text-text-body dark:text-gray-400 hover:text-action transition-colors duration-vercel"
              >
                <span
                  class="w-5 h-5 text-text-body/50"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                </span>
                {office.email}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

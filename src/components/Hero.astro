---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

/**
 * Hero Component
 * Performance: Largest Contentful Paint (LCP) optimized.
 * Design: High-precision kerning and dynamic mode tokens.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// High-impact visualization for IT consulting context.
// Free (Unsplash License) photo: the previous one was Unsplash+ (watermarked)
// and only 387px wide, which blurred when upscaled to the 1200px render size.
const techImage =
  "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=85&w=1800&auto=format&fit=crop";
---

<section
  class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 overflow-hidden bg-white dark:bg-brand-black"
>
  <div class="container mx-auto px-6 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <!-- Left Column: Copywriting with high-precision kerning -->
    <div class="relative z-10 min-w-0">
      <h1
        class="text-5xl lg:text-7xl font-bold text-heading mb-8 tracking-tightest leading-[1.05] wrap-anywhere hyphens-auto"
      >
        {t("hero.title.part1")}
        <span class="text-primary dark:text-brand-sky">
          {t("hero.title.highlight")}
        </span>
      </h1>

      <p class="text-xl text-body mb-10 max-w-lg leading-relaxed">
        {t("hero.description")}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#contact"
          class="bg-action text-center text-white dark:text-brand-black px-10 py-5 rounded-pill font-bold text-lg hover:scale-105 transition-all shadow-xl shadow-action/20 active:scale-95"
        >
          {t("hero.cta")}
        </a>
      </div>
    </div>

    <!-- Right Column: Interface Visualization (LCP Critical Path) -->
    <div class="relative animate-float min-w-0">
      <!-- Glow effect using brand-sky for better dark mode visibility -->
      <div
        class="absolute -inset-4 bg-brand-sky/20 rounded-full blur-3xl opacity-30 dark:opacity-20"
      >
      </div>

      <div
        class="relative bg-white dark:bg-surface p-2 rounded-card shadow-2xl border border-gray-100 dark:border-white/10"
      >
        <!-- Systematic Browser Header -->
        <div
          class="flex gap-1.5 p-3 border-b border-gray-100 dark:border-white/5"
        >
          <div class="w-2.5 h-2.5 rounded-pill bg-red-400/60"></div>
          <div class="w-2.5 h-2.5 rounded-pill bg-yellow-400/60"></div>
          <div class="w-2.5 h-2.5 rounded-pill bg-green-400/60"></div>
        </div>
        <div class="w-full aspect-4/3 bg-gray-100 dark:bg-white/5">
          <!-- The Image: Greyscale transition for focus -->
          <Image
            src={techImage}
            alt="company Software Architecture Interface"
            width={1200}
            height={900}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="rounded-b-inner object-cover w-full h-full grayscale-20 hover:grayscale-0 transition-all duration-700 ease-in-out"
          />
        </div>
      </div>

      <!-- Floating Badge: Quantitative Value Prop -->
      <article
        class="absolute -bottom-6 -right-2 sm:-right-6 bg-white dark:bg-surface border border-gray-100 dark:border-white/10 p-6 rounded-card shadow-2xl"
      >
        <p class="text-3xl font-bold text-primary dark:text-brand-sky mb-1">
          {t("hero.badge.years")}
        </p>
        <p class="text-[10px] font-bold text-body uppercase tracking-[0.2em]">
          {t("hero.badge.label")}
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  /* Premium float animation (Operational Silence) */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  .animate-float {
    animation: float 6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
</style>
